# Server-only — never commit real keys
AI_PROVIDER_PRIMARY=gemini
AI_PROVIDER_SECONDARY=grok

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# xAI / Grok secondary provider (used when Gemini fails)
XAI_API_KEY=
XAI_MODEL=grok-3
# Optional override (default https://api.x.ai/v1)
# XAI_BASE_URL=https://api.x.ai/v1

AI_INTENT_PARSE_TIMEOUT_MS=8000
AI_ROADMAP_GENERATE_TIMEOUT_MS=15000
AI_LESSON_GENERATE_TIMEOUT_MS=60000

# Client-visible — must be set in Vercel before build/redeploy to appear in the browser bundle
NEXT_PUBLIC_PRESENTER_MODE=false
